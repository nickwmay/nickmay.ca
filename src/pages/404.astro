---
import Base from '../layouts/Base.astro';
---

<Base title="Scene cut · Nick May" description="This page has been cut from the show." noindex>
  <main class="ghost">
    <a href="/" class="monogram ghost-mark" aria-label="Nick May, back to the show">
      <svg viewBox="0 0 100 100" width="44" height="44" aria-hidden="true">
        <circle class="mg-ring" cx="50" cy="50" r="35" pathLength="100" />
        <polyline class="mg-line" points="7,68 7,32 36,68 36,32 64,64 93,32 93,68" pathLength="100" />
      </svg>
    </a>

    <div class="ghost-stage" aria-hidden="true">
      <div class="ghost-glow"></div>
      <svg class="ghost-light" viewBox="0 0 60 200">
        <circle class="gl-bulb" cx="30" cy="22" r="12" />
        <path class="gl-cage" d="M18 22 a12 12 0 0 1 24 0 M18 22 a12 12 0 0 0 24 0 M30 10 V34 M20 14 Q30 22 20 30 M40 14 Q30 22 40 30" />
        <rect class="gl-pole" x="28" y="34" width="4" height="140" />
        <path class="gl-base" d="M30 172 L8 196 M30 172 L52 196 M30 172 V196" />
      </svg>
      <div class="ghost-floor"></div>
    </div>

    <div class="ghost-copy">
      <p class="ghost-kicker">404 · Scene not found</p>
      <h1 class="ghost-title">This scene has been cut.</h1>
      <p class="ghost-sub">The ghost light’s on, but there’s nobody on stage. Maybe it was in a rewrite, or maybe it was never in the script.</p>
      <div class="ghost-actions">
        <a class="ghost-btn primary" href="/">Back to the top of the show</a>
        <a class="ghost-btn" href="/#stage-door">Find the stage door</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .ghost {
    position: relative; min-height: 100svh; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 24px;
    padding: 80px clamp(16px, 6vw, 96px) 48px;
    background: radial-gradient(ellipse 60% 70% at 32% 62%, #2b1a14 0%, #0c0807 70%);
    color: #f3ead7;
  }
  .ghost-mark { position: absolute; top: 20px; left: clamp(16px, 4vw, 48px); color: #f7f5f0; }
  .ghost-stage { position: relative; height: min(70svh, 520px); }
  .ghost-glow {
    position: absolute; left: 50%; top: calc(20% - 250px); width: 520px; height: 520px; margin-left: -260px;
    background: radial-gradient(circle, rgba(255, 214, 140, .38) 0, rgba(255, 200, 120, .12) 30%, transparent 62%);
    animation: flicker 5s infinite;
  }
  .ghost-light { position: absolute; z-index: 1; left: 50%; bottom: 14px; height: 80%; width: auto; transform: translateX(-50%); overflow: visible; }
  .gl-bulb { fill: #fff1c9; filter: drop-shadow(0 0 18px rgba(255, 214, 140, .95)); animation: flicker 5s infinite; }
  .gl-cage { fill: none; stroke: #3a3029; stroke-width: 1.6; }
  .gl-pole, .gl-base { fill: #2a221d; stroke: #2a221d; stroke-width: 4; stroke-linecap: round; }
  .ghost-floor { position: absolute; left: -20%; right: -20%; bottom: 0; height: 36px; background: linear-gradient(180deg, #24180f, #120c08); border-top: 1px solid #3a2a1c; }
  .ghost-kicker { margin: 0; font: 600 12px/1 var(--body); letter-spacing: .3em; text-transform: uppercase; color: #e9c97b; }
  .ghost-title { margin: 16px 0 14px; font: 800 clamp(40px, 6vw, 76px)/1 var(--display); letter-spacing: -.02em; }
  .ghost-sub { margin: 0; max-width: 40ch; font: italic 400 20px/1.45 var(--display); color: #d9c7a5; }
  .ghost-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .ghost-btn { padding: 12px 20px; border: 1px solid #e9c97b; border-radius: 999px; color: #f3ead7; text-decoration: none; font-size: 15px; transition: background .25s, color .25s; }
  .ghost-btn.primary, .ghost-btn:hover { background: #e9c97b; color: #1d1714; }
  @keyframes flicker { 0%, 100% { opacity: 1; } 47% { opacity: 1; } 48% { opacity: .55; } 50% { opacity: .95; } 52% { opacity: .7; } 54% { opacity: 1; } }
  @media (max-width: 760px) {
    .ghost { grid-template-columns: 1fr; padding-top: 88px; text-align: center; }
    .ghost-stage { height: 260px; }
    .ghost-sub { margin: 0 auto; }
    .ghost-actions { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .ghost-glow, .gl-bulb { animation: none; } }
</style>
