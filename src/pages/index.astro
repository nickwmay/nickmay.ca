    <section id="act-2" class="section act rig-section" data-cue={`${acts.tech.cue} · GO`}>
      <h2 class="section-title reveal"><span class="eyebrow">{acts.tech.label}</span><span class="title-text">{acts.tech.title}</span></h2>
      <p class="act-sub">{acts.tech.sub}</p>
