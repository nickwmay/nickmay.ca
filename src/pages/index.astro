    <p class="foh-only">Please silence your phones. No flash photography. © {new Date().getFullYear()} Nick May.</p>
    <p class="bs-only">// built with Astro · hand-coded in Toronto · strike set after every deploy</p>
  </footer>

  <script>
    const root = document.documentElement;
    const btn = document.querySelector<HTMLButtonElement>('.mode-switch')!;
    const blackout = document.querySelector<HTMLElement>('.blackout')!;
    const cueLabel = blackout.querySelector('.blackout-cue')!;
    const terminal = document.querySelector<HTMLElement>('.terminal')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.mode === 'backstage'));
    sync();

    // Retype the terminal each time we go backstage.
    const retype = () => { terminal.classList.remove('typing'); void terminal.offsetWidth; terminal.classList.add('typing'); };
    if (root.dataset.mode === 'backstage') retype();

    function setMode(mode: 'foh' | 'backstage') {
      const apply = () => {
        root.dataset.mode = mode;
        sync();
        if (mode === 'backstage') retype();
        try { localStorage.setItem('nm-mode', mode); } catch {}
      };
      if (reduced) return apply();
      cueLabel.textContent = mode === 'backstage' ? 'LX BLACKOUT · GO' : 'HOUSE TO HALF · GO';
      blackout.classList.add('on');
      setTimeout(() => { apply(); blackout.classList.remove('on'); }, 450);
    }
    const toggle = () => setMode(root.dataset.mode === 'backstage' ? 'foh' : 'backstage');

    btn.addEventListener('click', toggle);
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.metaKey || e.ctrlKey || e.altKey || /INPUT|TEXTAREA/.test(t.tagName)) return;
      if (e.key.toLowerCase() === 'b') toggle();
    });

    // Spotlight follows the pointer on the cover.
    const cover = document.querySelector<HTMLElement>('.cover')!;
    cover.addEventListener('pointermove', (e) => {
      const r = cover.getBoundingClientRect();
      cover.style.setProperty('--sx', `${((e.clientX - r.left) / r.width) * 100}%`);
      cover.style.setProperty('--sy', `${((e.clientY - r.top) / r.height) * 100}%`);
    });

    // Count the stats up once they're lit.
    const countUp = (el: HTMLElement) => {
      const end = Number(el.dataset.count), suffix = el.dataset.suffix ?? '';
      if (reduced) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 1200);
        el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + suffix;
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // Things fade up as they enter, like lights on a cue.
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        en.target.classList.add('lit');
        const num = en.target.querySelector<HTMLElement>('[data-count]');
        if (num) countUp(num);
        io.unobserve(en.target);
      }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Poke the props: each click shows the next line.
    document.querySelectorAll<HTMLButtonElement>('.prop').forEach((prop) => {
      const lines: string[] = JSON.parse(prop.dataset.lines ?? '[]');
      const out = prop.parentElement!.querySelector('.prop-line')!;
      let i = 0;
      prop.addEventListener('click', () => {
        i = (i + 1) % lines.length;
        out.textContent = lines[i];
        prop.classList.remove('boing'); void prop.offsetWidth; prop.classList.add('boing');
      });
    });
    // Its eyes follow you around the room.
    addEventListener('pointermove', (e) => {
      document.querySelectorAll<SVGCircleElement>('.spud .pupil').forEach((p) => {
        const r = p.ownerSVGElement!.getBoundingClientRect();
        const dx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / 300));
        const dy = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / 300));
        p.style.transform = `translate(${dx * 3}px, ${dy * 3}px)`;
      });
    });

    // Deal with it.
    const hsBtn = document.querySelector<HTMLButtonElement>('.headshot-btn');
    hsBtn?.addEventListener('click', () => {
      const on = hsBtn.classList.toggle('shades-on');
      hsBtn.setAttribute('aria-pressed', String(on));
    });

    // Pause / play buttons for anything that moves on its own.
    function setMotionButton(btn: HTMLButtonElement, paused: boolean) {
      btn.setAttribute('aria-pressed', String(paused));
      btn.querySelector('.mb-label')!.textContent = paused ? 'Play' : 'Pause';
    }
    document.querySelector<HTMLButtonElement>('[data-motion="reel"]')?.addEventListener('click', (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const win = document.querySelector('.reel-window')!;
      setMotionButton(btn, win.classList.toggle('paused'));
    });

    // The Creative: a little stage with scene changes.
    const mini = document.querySelector<HTMLElement>('.mini');
    if (mini) {
      const sets = mini.querySelectorAll('.set');
      const caps = mini.querySelectorAll('.cap');
      const cues = mini.querySelectorAll<HTMLButtonElement>('.mini-cue');
      let cur = 0, timer = 0, busy = false, held = false;
      const show = (n: number) => {
        if (n === cur || busy) return;
        const swap = () => {
          [sets, caps, cues].forEach((list) => list.forEach((el, i) => el.classList.toggle('on', i === n)));
          cues.forEach((c, i) => c.setAttribute('aria-pressed', String(i === n)));
          cur = n;
        };
        if (reduced) return swap();
        busy = true;
        mini.classList.add('closing');
        setTimeout(() => { swap(); mini.classList.remove('closing'); busy = false; }, 550);
      };
      const auto = () => { clearInterval(timer); if (!reduced && !held) timer = window.setInterval(() => show((cur + 1) % sets.length), 5200); };
      cues.forEach((c) => c.addEventListener('click', () => { show(Number(c.dataset.i)); auto(); }));
      mini.addEventListener('pointerenter', () => clearInterval(timer));
      mini.addEventListener('pointerleave', auto);
      new IntersectionObserver(([e]) => (e.isIntersecting ? auto() : clearInterval(timer))).observe(mini);
      mini.querySelector<HTMLButtonElement>('[data-motion="mini"]')?.addEventListener('click', (ev) => {
        held = !held;
        setMotionButton(ev.currentTarget as HTMLButtonElement, held);
        held ? clearInterval(timer) : auto();
      });
    }

    // Talks whose date has passed move from Coming up to Previously.
    {
      const d = new Date();
      const todayISO = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const past = document.querySelector('.bill-past');
      document.querySelectorAll<HTMLElement>('.bill-upcoming .bill-item').forEach((li) => {
        if ((li.dataset.on ?? '') >= todayISO) return;
        li.classList.remove('upcoming');
        li.querySelector('.live-dot')?.remove();
        past?.prepend(li);
      });
      const head = document.getElementById('bill-upcoming-head');
      if (head) head.hidden = !document.querySelector('.bill-upcoming .bill-item');
    }

    // Act II: lights come up on cue, and a click focuses one.
    const rig = document.querySelector<HTMLElement>('.rig');
    if (rig) {
      new IntersectionObserver(([e], obs) => { if (e.isIntersecting) { rig.classList.add('lit'); obs.disconnect(); } }, { threshold: .25 }).observe(rig);
      const cols = rig.querySelectorAll<HTMLElement>('.rig-col');
      cols.forEach((col) => col.addEventListener('click', () => {
        const same = col.classList.contains('focus');
        cols.forEach((c) => { c.classList.remove('focus'); c.querySelector('.fixture')!.setAttribute('aria-pressed', 'false'); });
        rig.classList.toggle('focusing', !same);
        if (!same) { col.classList.add('focus'); col.querySelector('.fixture')!.setAttribute('aria-pressed', 'true'); }
      }));
    }

    // Flip the early-job badges.
    document.querySelectorAll('.badge').forEach((b) => b.addEventListener('click', () => b.classList.toggle('flipped')));

    // Tear off a ticket stub.
    document.querySelectorAll('.ticket').forEach((t) => t.addEventListener('click', () => t.classList.toggle('torn')));
  </script>
</Base>
