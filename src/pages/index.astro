---
import Base from '../layouts/Base.astro';
import {
  contact, prologue, earlyJobs, mcdArches, hospitality, onTour, tech, companies, shopifyBag, throughline, speaking, speakingTopics, board, potatoPuns, coachingQuestions, repertory, theatreStats, beliefs, inDevelopment,
} from '../data/show';

const acts = {
  prologue: { id: 'prologue', cue: 'LX 2', label: 'Prologue', title: 'The Creative', sub: 'Born in Toronto. Raised by the theatre.', scenes: prologue },
  hospitality: { id: 'act-1', cue: 'LX 3', label: 'Act I', title: 'Odd Jobs to Operator', sub: 'From Commodore 64 crosswords to general manager', scenes: hospitality },
  tech: { id: 'act-2', cue: 'LX 5', label: 'Act II', title: 'The Tech Operator', sub: 'Product, technical & people operations, 2017–now', scenes: tech },
};
type Act = (typeof acts)[keyof typeof acts];

const name = 'Nick May';
// Dust in the spotlight. Fixed seed so the build is stable.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const motes = Array.from({ length: 22 }, () => ({
  x: Math.round(rand() * 100), y: Math.round(rand() * 100),
  s: (1 + rand() * 2.5).toFixed(1), d: (8 + rand() * 10).toFixed(1), delay: (-rand() * 10).toFixed(1),
}));
const bulbs = Array.from({ length: 19 });
// Talks sort themselves by date at build time; a script below re-checks in the browser.
const today = new Date().toISOString().slice(0, 10);
const upcomingTalks = speaking.filter((e) => e.on >= today).sort((a, b) => a.on.localeCompare(b.on));
const pastTalks = speaking.filter((e) => e.on < today).sort((a, b) => b.on.localeCompare(a.on));
---

<Base
  title="Nick May: theatre, hospitality, tech"
  description="Nick May builds systems that scale and still feel human. Senior Director at Wealthsimple, formerly Shopify, and director/producer with Theatre Topikós."
>
  <div class="blackout" aria-hidden="true"><span class="blackout-cue">STANDBY</span></div>

  <header class="marquee">
    <a href="#cover" class="monogram" aria-label="Nick May, back to top">
      <svg viewBox="0 0 100 100" width="44" height="44" aria-hidden="true">
        <circle class="mg-ring" cx="50" cy="50" r="35" pathLength="100" />
        <polyline class="mg-line" points="7,68 7,32 36,68 36,32 64,64 93,32 93,68" pathLength="100" />
      </svg>
      <span class="monogram-word">Nick&nbsp;May</span>
    </a>
    <nav class="marquee-nav" aria-label="Sections">
      <a href="#whos-who">Who’s Who</a>
      <a href="#speaking">Speaking</a>
      <a href="#repertory">Theatre</a>
      <a href="#stage-door">Contact</a>
    </nav>
    <button class="mode-switch" type="button" aria-pressed="false" title="Switch view (B)">
      <span class="mode-opt mode-foh">Front of House</span>
      <span class="mode-opt mode-bs">Backstage</span>
    </button>
  </header>

  <main>
    <!-- COVER -->
    <section id="cover" class="cover" data-cue="LX 1 · GO">
      <div class="curtain curtain-l" aria-hidden="true"></div>
      <div class="curtain curtain-r" aria-hidden="true"></div>
      <div class="motes" aria-hidden="true">
        {motes.map((m) => <span style={`--x:${m.x}%;--y:${m.y}%;--s:${m.s}px;--d:${m.d}s;--delay:${m.delay}s`}></span>)}
      </div>

      <div class="cover-inner foh-only">
        <div class="bulbs" aria-hidden="true">{bulbs.map((_, i) => <i style={`--i:${i % 3}`}></i>)}</div>
        <p class="cover-kicker">The Programme · Toronto · Season 2026</p>
        <h1 class="cover-title" aria-label="Nick May in The Jungle Gym">
          <span class="cover-name" aria-hidden="true">
            {[...name].map((ch, i) => <span class="ltr" style={`--n:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
          </span>
          <span class="cover-in" aria-hidden="true">in</span>
          <span class="cover-show" aria-hidden="true">The Jungle Gym</span>
        </h1>
        <p class="cover-sub">A career in several acts. Theatre. Hospitality. Tech.<br />Running time: ongoing.</p>
        <div class="bulbs" aria-hidden="true">{bulbs.map((_, i) => <i style={`--i:${i % 3}`}></i>)}</div>
        <a href="#whos-who" class="cover-cta">Take your seat ↓</a>
      </div>

      <div class="cover-inner bs-only">
        <p class="cover-kicker">PROMPT BOOK — THE JUNGLE GYM — rev. 2026.10</p>
        <pre class="terminal" aria-label="Terminal"><span class="tl" style="--l:0"><span class="t-prompt">sm@stage-left ~ $</span> whoami</span>
<span class="tl" style="--l:1">nick may</span>
<span class="tl" style="--l:2"><span class="t-prompt">sm@stage-left ~ $</span> cat roles.txt</span>
<span class="tl" style="--l:3">producer   director   dramaturg</span>
<span class="tl" style="--l:4">operator   systems-thinker</span>
<span class="tl" style="--l:5"><span class="t-prompt">sm@stage-left ~ $</span> uptime</span>
<span class="tl" style="--l:6">since theatre school · 3 careers · 0 regrets</span>
<span class="tl" style="--l:7"><span class="t-prompt">sm@stage-left ~ $</span> <span class="t-cursor">▍</span></span></pre>
        <p class="sm-note">// SM note: same show, crew’s view. Press <kbd>B</kbd> to go back out front.</p>
      </div>
    </section>

    <!-- WHO'S WHO -->
    <section id="whos-who" class="section whos-who" data-cue="LX 1.5">
      <h2 class="section-title reveal"><span class="eyebrow">Who’s Who in the Cast</span><span class="title-text">Nick May</span></h2>
      <div class="whos-who-body">
        <figure class="headshot reveal">
          <button class="headshot-btn" type="button" aria-label="Put the sunglasses on Nick" aria-pressed="false">
            <img class="hs hs-a" src="/images/headshot-smile.jpg" alt="Nick May, smiling" width="800" height="1000" />
            <img class="hs hs-b" src="/images/headshot-smirk.jpg" alt="" aria-hidden="true" width="800" height="1000" loading="lazy" />
            <svg class="shades" viewBox="0 0 26 7" shape-rendering="crispEdges" aria-hidden="true">
              <g fill="#000">
                <rect x="0" y="0" width="26" height="1" /><rect x="0" y="1" width="2" height="1" /><rect x="24" y="1" width="2" height="1" />
                <rect x="2" y="1" width="9" height="3" /><rect x="3" y="4" width="7" height="1" /><rect x="4" y="5" width="5" height="1" />
                <rect x="15" y="1" width="9" height="3" /><rect x="16" y="4" width="7" height="1" /><rect x="17" y="5" width="5" height="1" />
                <rect x="11" y="1" width="4" height="1" />
              </g>
              <g fill="#fff"><rect x="4" y="1" width="1" height="1" /><rect x="3" y="2" width="1" height="1" /><rect x="17" y="1" width="1" height="1" /><rect x="16" y="2" width="1" height="1" /></g>
            </svg>
          </button>
          <figcaption class="bs-only">TALENT · HEADSHOT · NICK MAY</figcaption>
        </figure>
        <div class="bio">
          <p class="bio-lede">
            <strong>NICK MAY</strong> <em>(He/Him)</em> is thrilled to be making his debut on this website.
            A theatre nerd at heart, his career took the jungle-gym route: theatre, then hospitality, then tech. What looked unrelated turned into an unfair advantage.
          </p>
          <p>
            By day he’s Senior Director, Talent Operations &amp; Technology at Wealthsimple, building people systems that scale and still feel human.
            Before that he spent the better part of a decade at Shopify, ending as Director of Technical Operations and Chief of Staff to the CTO.
          </p>
          <p>
            During rare moments of “free time”, he is the creative director/producer of <a href={contact.topikos}>Theatre Topikós</a>,
            a Toronto queer theatre collective he co-founded in 2014. He’s produced work in three countries, won Best New Play at the Toronto Fringe,
            and sits on the board of the <a href={board.url}>SummerWorks Performance Festival</a>.
          </p>
          <p>
            He also speaks on panels about AI, work and queer leadership.
          </p>
          <p class="bio-thanks">
            He wanted to be a roller coaster tester, but couldn’t break into that industry. Thanks to every mentor along the way.
          </p>
          <p class="sm-note bs-only">// SM note: theatre kid → GM → tour director → ops → director. Every role is a rehearsal for the next one.</p>
        </div>
      </div>
    </section>

    <!-- DIRECTOR'S NOTE: THE THROUGHLINE -->
    <section id="throughline" class="section throughline" data-cue="LX 1.8 · SPOT">
      <h2 class="section-title reveal"><span class="eyebrow">A Note from the Director</span><span class="title-text">The Throughline</span></h2>
      <p class="act-sub">
        Three careers, one job: make the show run, and make everyone in the room feel looked after.
        Every act taught a piece of it.
      </p>
      <div class="strands">
        {throughline.strands.map((st, i) => (
          <article class="strand reveal" style={`--d:${i * 140}ms`}>
            <p class="strand-act">{st.act}</p>
            <p class="strand-lesson">{st.lesson}</p>
            <p class="strand-skill">{st.skill}</p>
          </article>
        ))}
      </div>
      <svg class="merge reveal" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M100 0 C100 70, 300 50, 300 120" />
        <path d="M300 0 L300 120" />
        <path d="M500 0 C500 70, 300 50, 300 120" />
      </svg>
      <p class="thesis reveal"><span class="foh-only">“{throughline.thesis}”</span><span class="bs-only">return "{throughline.thesis}";</span></p>
    </section>

    <!-- RUNNING ORDER -->
    <section class="section running-order" data-cue="SND 1">
      <h2 class="section-title reveal"><span class="eyebrow">Running Order</span><span class="title-text">Tonight’s Programme</span></h2>
      <ol class="ro-list">
        {[
          ['#prologue', 'Prologue', 'The Creative'],
          ['#act-1', 'Act I', 'Odd Jobs to Operator'],
          ['#on-tour', 'Entr’acte', 'The Touring Company'],
          ['#act-2', 'Act II', 'The Tech Operator'],
          ['#repertory', 'In Repertory', 'The Director / Producer'],
          ['#speaking', 'Special Engagement', 'On the Bill'],
          ['#intermission', 'Intermission', 'Notes from the Lobby'],
          ['#in-development', 'Act III', 'In Development'],
          ['#stage-door', 'Curtain Call', 'The Stage Door'],
        ].map(([href, label, title], i) => (
          <li class="reveal" style={`--d:${i * 60}ms`}><a href={href}><span class="ro-label">{label}</span><span class="ro-dots"></span><span class="ro-title">{title}</span></a></li>
        ))}
      </ol>
    </section>

    <!-- PROLOGUE: a little stage you can play -->
    <section id="prologue" class="section prologue" data-cue="LX 2 · GO">
      <h2 class="section-title reveal"><span class="eyebrow">{acts.prologue.label}</span><span class="title-text">{acts.prologue.title}</span></h2>
      <p class="act-sub">{acts.prologue.sub}</p>
      <div class="mini" data-scene="0">
        <div class="mini-stage" aria-hidden="true">
          <div class="mini-sky"></div>
          {prologue.map((sc, i) => (
            <svg class:list={['set', `set-${sc.set}`, { on: i === 0 }]} viewBox="0 0 400 170" preserveAspectRatio="xMidYMax meet">
              {sc.set === 'toronto' && (<g>
                <g class="sil">
                  <rect x="8" y="120" width="22" height="50" /><rect x="32" y="98" width="18" height="72" /><rect x="52" y="110" width="20" height="60" /><rect x="74" y="84" width="16" height="86" />
                  <rect x="92" y="104" width="22" height="66" /><rect x="116" y="92" width="14" height="78" />
                  <path d="M146 170 V82 h-7 l5 -9 h14 l5 9 h-7 V170 Z" /><rect x="150" y="10" width="2.5" height="64" /><rect x="140" y="98" width="22" height="5" />
                  <path d="M166 170 V152 A42 26 0 0 1 250 152 V170 Z" />
                  <rect x="254" y="96" width="18" height="74" /><rect x="274" y="76" width="20" height="94" /><rect x="290" y="56" width="48" height="114" />
                  <rect x="332" y="88" width="18" height="82" /><rect x="352" y="112" width="22" height="58" /><rect x="376" y="100" width="20" height="70" />
                </g>
                <g class="dome-ribs"><path d="M178 152 A30 20 0 0 1 238 152" /><path d="M190 154 A18 14 0 0 1 226 154" /><path d="M208 126 V170" /></g>
                <g class="windows">{[[34,104],[34,118],[42,132],[76,92],[82,110],[94,112],[100,128],[276,84],[284,100],[276,118],[334,96],[340,114],[378,108],[384,124],[56,118],[58,136]].map(([x, y]) => <rect x={x} y={y} width="4" height="5" />)}</g>
                <g class="windows">{[[294,64],[294,80],[294,96],[294,112],[330,64],[330,80],[330,96],[330,112]].map(([x, y]) => <rect x={x} y={y} width="4" height="6" />)}</g>
                <g class="mirvish">
                  <rect class="mv-board" x="305" y="60" width="18" height="80" rx="2" />
                  {[...'MIRVISH'].map((ch, i) => <text class="mv-text" x="314" y={74 + i * 9.6} text-anchor="middle">{ch}</text>)}
                  {Array.from({ length: 9 }, (_, i) => <circle class="mbulb" cx="302" cy={63 + i * 9.2} r="1.6" style={`--i:${i % 3}`} />)}
                  {Array.from({ length: 9 }, (_, i) => <circle class="mbulb" cx="326" cy={63 + i * 9.2} r="1.6" style={`--i:${(i + 1) % 3}`} />)}
                  <rect class="mv-marquee" x="288" y="142" width="52" height="12" rx="1" /><text class="mv-small" x="314" y="150.5" text-anchor="middle">ED MIRVISH</text>
                  {Array.from({ length: 7 }, (_, i) => <circle class="mbulb" cx={291 + i * 7.7} cy="157" r="1.4" style={`--i:${i % 3}`} />)}
                </g>
              </g>)}
              {sc.set === 'stage' && (<g>
                <rect class="boards" x="0" y="150" width="400" height="20" />
                <g class="grease">
                  <rect class="grease-board" x="36" y="18" width="134" height="62" rx="4" />
                  <text class="grease-text" x="103" y="60" text-anchor="middle">Grease</text>
                  <text class="grease-sub" x="103" y="74" text-anchor="middle">HIGH SCHOOL · TONIGHT</text>
                </g>
                <circle class="sil" cx="80" cy="112" r="9" /><path class="sil" d="M68 150 Q70 124 80 122 Q90 124 92 150 Z" />
                <circle class="sil" cx="122" cy="114" r="8" /><path class="sil" d="M111 150 Q113 126 122 124 Q131 126 133 150 Z" />
                <g class="aframe" transform="translate(168 94)"><path class="af-legs" d="M4 56 L26 0 L48 56" /><rect class="af-board" x="2" y="8" width="48" height="36" rx="2" /><text class="af-text" x="26" y="20" text-anchor="middle">COMMUNITY</text><text class="af-text" x="26" y="29" text-anchor="middle">THEATRE</text><text class="af-text af-red" x="26" y="38" text-anchor="middle">TONIGHT</text></g>
                <g class="wss">
                  <text class="movie-kicker" x="298" y="18" text-anchor="middle">NOW PLAYING</text>
                  {Array.from({ length: 12 }, (_, i) => <circle class="mbulb" cx={244 + i * 9.8} cy="24" r="1.8" style={`--i:${i % 3}`} />)}
                  <rect class="poster-frame" x="240" y="28" width="116" height="116" rx="2" />
                  <image href="/images/west-side-story.jpg" x="246" y="34" width="104" height="104" preserveAspectRatio="xMidYMid slice" />
                </g>
                {[40, 70, 100, 130, 160].map((x) => <circle class="footlight" cx={x} cy="152" r="4" />)}
              </g>)}
              {sc.set === 'nyc' && (<g>
                <g class="beams"><path class="beam beam-a" d="M120 170 L84 0 L104 0 Z" /><path class="beam beam-b" d="M260 170 L292 0 L312 0 Z" /></g>
                <g class="sil">
                  <rect x="10" y="100" width="36" height="70" /><rect x="50" y="70" width="28" height="100" /><rect x="82" y="110" width="30" height="60" />
                  <path d="M128 170 V70 h6 V52 h6 V36 h4 V14 h2 V36 h4 V52 h6 V70 h6 V170 Z" />
                  <rect x="172" y="88" width="34" height="82" /><path d="M214 170 V60 l12 -16 l12 16 V170 Z" /><rect x="244" y="104" width="30" height="66" />
                  <rect x="278" y="82" width="26" height="88" /><rect x="308" y="116" width="34" height="54" /><rect x="346" y="96" width="44" height="74" />
                  <rect x="286" y="62" width="4" height="20" /><rect x="328" y="62" width="4" height="54" />
                </g>
                <g class="windows nyc-win">{[[14,108],[22,122],[34,110],[56,78],[64,96],[56,120],[86,118],[96,132],[176,96],[186,112],[196,128],[248,112],[258,126],[282,92],[292,108],[312,124],[350,104],[362,118],[374,132]].map(([x, y]) => <rect x={x} y={y} width="4" height="5" />)}</g>
                <g class="bway"><rect class="bway-board" x="57" y="76" width="14" height="78" rx="2" />{[...'BROADWAY'].map((ch, i) => <text class="bway-text" x="64" y={86 + i * 9} text-anchor="middle">{ch}</text>)}</g>
                <rect class="billboard bb-pink" x="175" y="92" width="28" height="18" rx="1" /><rect class="billboard bb-cyan" x="247" y="108" width="24" height="14" rx="1" /><rect class="billboard bb-gold" x="349" y="100" width="22" height="16" rx="1" />
                <g class="street-marquee"><rect x="150" y="150" width="100" height="14" rx="2" /><text x="200" y="160" text-anchor="middle">TONIGHT ON BROADWAY</text>{Array.from({ length: 14 }, (_, i) => <circle class="mbulb" cx={153 + i * 7.2} cy="148" r="1.6" style={`--i:${i % 3}`} />)}</g>
                <g class="amda"><rect class="amda-board" x="280" y="30" width="56" height="34" rx="2" /><text class="amda-text" x="308" y="51" text-anchor="middle">AMDA</text><rect class="amda-bar" x="284" y="54" width="48" height="7" /><text class="amda-sub" x="308" y="59.6" text-anchor="middle">NEW YORK CITY</text></g>
                <g transform="translate(0 30)"><g class="plane"><path class="trail" d="M-70 0 H-14" /><path class="plane-body" d="M-16 -2 H14 Q22 0 14 2 H-16 Z M-4 -2 L-10 -12 H-5 L4 -2 Z M-4 2 L-10 12 H-5 L4 2 Z M-14 -2 L-18 -8 H-14 L-10 -2 Z" /></g></g>
              </g>)}
              {sc.set === 'home' && (<g>
                <g class="sil"><path d="M56 170 V82 h-7 l5 -9 h14 l5 9 h-7 V170 Z" /><rect x="60" y="12" width="2.5" height="62" /><rect x="10" y="118" width="34" height="52" /><path d="M76 170 V154 A30 20 0 0 1 136 154 V170 Z" /><rect x="140" y="110" width="22" height="60" /></g>
                <g transform="translate(400 34) scale(-1 1)"><g class="plane"><path class="trail" d="M-70 0 H-14" /><path class="plane-body" d="M-16 -2 H14 Q22 0 14 2 H-16 Z M-4 -2 L-10 -12 H-5 L4 -2 Z M-4 2 L-10 12 H-5 L4 2 Z M-14 -2 L-18 -8 H-14 L-10 -2 Z" /></g></g>
                <g class="desk"><rect class="desk-top" x="196" y="128" width="190" height="8" rx="2" /><rect class="desk-leg" x="206" y="136" width="6" height="34" /><rect class="desk-leg" x="370" y="136" width="6" height="34" /></g>
                <g class="laptop"><rect class="lt-screen" x="262" y="72" width="80" height="52" rx="4" /><rect class="lt-glow" x="267" y="77" width="70" height="42" rx="2" /><text class="lt-code" x="302" y="103" text-anchor="middle">&lt;/&gt;</text><path class="lt-base" d="M252 124 H352 L346 128 H258 Z" /></g>
                <g class="suitcase" transform="translate(206 92) scale(.55)"><rect x="0" y="10" width="96" height="60" rx="8" /><rect class="handle" x="34" y="0" width="28" height="14" rx="5" /><text x="48" y="48" text-anchor="middle">NYC → TO</text></g>
              </g>)}
              {sc.set === 'topikos' && (<g>
                <rect class="marquee-box" x="60" y="40" width="280" height="86" rx="6" />
                <text class="marquee-kicker" x="200" y="68" text-anchor="middle">NOW PLAYING</text>
                <text class="marquee-name" x="200" y="102" text-anchor="middle">THEATRE TOPIKÓS</text>
                {Array.from({ length: 20 }, (_, i) => <circle class="mbulb" cx={70 + i * 13.7} cy="48" r="3" style={`--i:${i % 3}`} />)}
                {Array.from({ length: 20 }, (_, i) => <circle class="mbulb" cx={70 + i * 13.7} cy="118" r="3" style={`--i:${(i + 1) % 3}`} />)}
                <rect class="sil" x="120" y="126" width="8" height="44" /><rect class="sil" x="272" y="126" width="8" height="44" />
                <text class="ff" x="34" y="26">▶▶ FAST FORWARD · A FEW YEARS LATER</text>
                <g class="stamp" transform="translate(262 138) rotate(-12)"><rect x="-86" y="-17" width="172" height="34" rx="4" /><text x="0" y="6" text-anchor="middle" textLength="150" lengthAdjust="spacingAndGlyphs">SPOILER ALERT!</text></g>
              </g>)}
            </svg>
          ))}
          <div class="mini-spot"></div>
          <div class="mini-curtain mini-curtain-l"></div>
          <div class="mini-curtain mini-curtain-r"></div>
          <div class="mini-valance"></div>
        </div>
        <div class="mini-caption" aria-live="polite">
          {prologue.map((sc, i) => (
            <div class:list={['cap', { on: i === 0 }]}>
              <p class="cap-scene">{sc.years} of {prologue.length}{sc.tag && <span class="cap-tag">{sc.tag}</span>}</p>
              <h3 class="cap-role">{sc.role}</h3>
              <p class="cap-where">{sc.where}</p>
              {sc.note && <p class="cap-note">{sc.note}</p>}
            </div>
          ))}
        </div>
        <div class="mini-controls"><button class="motion-btn" type="button" data-motion="mini" aria-pressed="false"><span class="mb-icon" aria-hidden="true"></span><span class="mb-label">Pause</span></button></div>
        <div class="mini-cues" role="group" aria-label="Choose a scene">
          {prologue.map((sc, i) => (
            <button type="button" class:list={['mini-cue', { on: i === 0 }]} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="mc-n">{i + 1}</span><span class="mc-t">{sc.role}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    {[acts.hospitality].map((a: Act) => (
      <section id={a.id} class="section act" data-cue={`${a.cue} · GO`}>
        <h2 class="section-title reveal"><span class="eyebrow">{a.label}</span><span class="title-text">{a.title}</span></h2>
        <p class="act-sub">{a.sub}</p>
        {a.id === 'act-1' && (
          <div class="reel reveal">
            <p class="reel-title"><span>Opening Number</span> · Odd jobs, early learning &amp; growing</p>
            <div class="reel-window">
              <ul class="reel-row">
                {[0, 1].map((copy) => earlyJobs.map((j) => (
