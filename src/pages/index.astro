          <ul class="rig-stints" aria-label="Companies">
            {companies.map((c) => (
              <li class="stint" style={`grid-column: span ${c.span}; --brand:${c.color}; --ink-on:${c.ink}`}>
                <span class="stint-bracket" aria-hidden="true"></span>
                <span class="stint-tag">
                  <span class="stint-logo">
                    {c.logo && <img class:list={['lam-logo', { invert: c.invert }]} src={c.logo} alt={c.name} />}
                    {c.bag && (<span class="lam-shopify"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={shopifyBag} /></svg><span>shopify</span></span>)}
                  </span>
                  <span class="stint-meta">{c.act ? `${c.act} · ` : ''}{c.years}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="rig-pipe" aria-hidden="true"></div>
          <ol class="rig-lights">
            {tech.map((s, i) => {
              const brand = companies.find((c) => c.name === s.where)?.color ?? 'var(--accent)';
              return (
                <li class="rig-col" style={`--i:${i}; --brand:${brand}`} data-i={i}>
                  <button class="fixture" type="button" aria-label={`Focus ${s.role}, ${s.years}`} aria-pressed="false">
                    <svg viewBox="0 0 40 52" aria-hidden="true">
                      <rect class="fx-clamp" x="17" y="0" width="6" height="7" rx="1" />
                      <path class="fx-yoke" d="M8 26 V10 H32 V26" />
                      <rect class="fx-can" x="10" y="14" width="20" height="26" rx="4" />
                      <ellipse class="fx-lens" cx="20" cy="42" rx="11" ry="4.5" />
                    </svg>
                    <span class="fx-num" aria-hidden="true">{i + 1}</span>
                  </button>
                  <span class="beam" aria-hidden="true"></span>
                  <article class="rig-card">
                    <p class="rc-years">{s.years}</p>
                    <h3 class="rc-role">{s.role}</h3>
                    <p class="rc-where">{s.where}</p>
                    {s.note && <p class="rc-note">{s.note}</p>}
                  </article>
                </li>
              );
            })}
