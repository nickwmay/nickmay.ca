          <circle cx="32" cy="38" r="12" class="pp-crest" /><path d="M24 38 H40 M32 28 V48 M26 31 Q32 38 26 45 M38 31 Q32 38 38 45" class="pp-crest-lines" />
          <text x="32" y="66" text-anchor="middle" class="pp-word">PASSPORT</text>
