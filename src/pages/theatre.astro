---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contact, board, repertory, theatreStats } from '../data/show';
---

<Base
  title="Theatre · Nick May"
  description="Nick May in repertory: director, producer and dramaturg with Theatre Topikós since 2014. POZ, Wordplay, 5 Guys Chillin’ and more, from Toronto to Dublin, Edinburgh and Montreal."
>
  <SiteHeader current="theatre" />

  <main class="theatre-page">
    <section class="section s2-hero" data-cue="LX 1 · FLY OUT">
      <a class="s2-back" href="/#repertory">← Back to the main stage</a>
      <div class="s2-masthead reveal">
        <h1 class="s2-h1"><span class="eyebrow">Running in Repertory, 2014–now</span>The Director / Producer</h1>
        <p class="s2-intro">Producer, director, dramaturg. Toronto to Dublin and back.</p>
      </div>
    </section>

    <section id="repertory" class="section repertory" data-cue="LX 2 · REPERTORY">
      <p class="act-sub">
        With <a href={contact.topikos}>Theatre Topikós</a>, Nick produces, directs and does dramaturgy on bold, topical queer work,
        and co-leads the Toronto Queer Theatre Festival with Mark Keller. Shows have toured from Toronto to Dublin, Edinburgh and Montreal.
      </p>

      <ul class="stats">
        {theatreStats.map((s) => (
          <li class="stat reveal">
            <span class="stat-num" data-count={s.value} data-suffix={s.suffix ?? ''}>{s.value}{s.suffix ?? ''}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>

      <ul class="rep-list">
        {repertory.map((p, i) => (
          <li class="rep reveal" style={`--d:${i * 70}ms`}>
            <img src={p.img} alt={`${p.title} poster`} loading="lazy" width="96" height="96" />
            <div>
              <p class="rep-meta">{p.year} · {p.credit}</p>
              <h3 class="rep-title">{p.title}</h3>
              <p class="rep-where">{p.where}</p>
              {p.laurel && <p class="rep-laurel">★ {p.laurel}</p>}
              <p class="rep-blurb">{p.blurb}</p>
            </div>
          </li>
        ))}
      </ul>

      <a class="topikos-cta reveal" href={contact.topikos}>
        <span class="tc-logo" role="img" aria-label="Theatre Topikós logo"><span></span></span>
        <span class="tc-kicker">Now playing</span>
        <span class="tc-title">Theatre Topikós</span>
        <span class="tc-arrow" aria-hidden="true">→</span>
      </a>
      <a class="board reveal" href={board.url}>
        <img class="board-logo" src="/images/logos/summerworks.jpg" alt="SummerWorks Performance Festival logo" width="72" height="72" loading="lazy" />
        <span class="board-role">{board.role}</span>
        <span class="board-org">{board.org}</span>
        <span class="board-arrow" aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <SiteFooter />
</Base>

<script>
  // Stats count up once they're lit (the header's observer fires nm:lit).
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.addEventListener('nm:lit', (e) => {
    const el = (e.target as HTMLElement).querySelector<HTMLElement>('[data-count]');
    if (!el || reduced) return;
    const end = Number(el.dataset.count), suffix = el.dataset.suffix ?? '';
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1200);
      el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + suffix;
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });
</script>
